#!/usr/bin/env python3
"""omi-dict — Omi dictionary service CLI.

The stable command-line contract between the dictionary engine and every
other Omi component (DMS popup, Pi, scripts).  Usable with no desktop
session at all.
"""

from __future__ import annotations

import os
import sys

# Resolve symlinks so ~/.local/bin/omi-dict → repo/bin/omi-dict still finds
# ../src (plain abspath would resolve ../src against ~/.local/bin).
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(_HERE, "..", "src"))

from omi_dict.cli import main

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
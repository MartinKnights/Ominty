#!/bin/sh
# Ominty Reader — pick a document and read it aloud.
#
# Launched from niri (Super+Alt+O), so stderr is invisible. Every failure has
# to be surfaced in a dialog: a picker that silently does nothing is the worst
# possible outcome (LMDE 7, 2026-10-24: the extraction tools were missing).
#
# Requires: zenity, pandoc/pdftotext/catdoc (tts layer), Piper in ~/.piper-venv.

f=$(zenity --file-selection \
    --title="Ominty Reader — select a document" \
    --file-filter='Documents (md txt pdf doc docx epub) | *.md *.txt *.pdf *.doc *.docx *.epub' \
    2>/dev/null) || exit 0
[ -n "$f" ] || exit 0

if out=$(ominty tts say "$f" 2>&1); then
    exit 0
fi

msg=$(printf '%s' "$out" | sed 's/^[[:space:]]*//' | sed '/^$/d' | head -5)

zenity --error --title="Ominty Reader" --width=560 --no-markup \
    --text="Could not read that document.

$msg" 2>/dev/null \
    || notify-send -u critical "Ominty Reader" "$msg" 2>/dev/null

exit 1

#!/bin/bash
# Read selected text aloud using Piper TTS
# Strips common markdown formatting before sending to TTS
#
# Usage:
#   read-selection              speak the PRIMARY selection (default)
#   read-selection --clipboard  speak the clipboard instead
#
# There is no key-release event under Niri, so this is fire-and-forget: it
# writes the cleaned text to the daemon's queue and exits.

QUEUE_FILE="${PIPER_QUEUE_FILE:-/tmp/piper_queue.txt}"

SOURCE="primary"
case "${1:-}" in
    --clipboard) SOURCE="clipboard" ;;
    ""|--primary) ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: read-selection [--primary|--clipboard]" >&2; exit 2 ;;
esac

# clip-tool selects wl-paste under Wayland (Niri) and xclip/xsel under X11
# (Cinnamon), so this works unchanged in either session.
CLIP_TOOL="$HOME/.local/bin/clip-tool"
[ -x "$CLIP_TOOL" ] || CLIP_TOOL="clip-tool"

if [ "$SOURCE" = "clipboard" ]; then
    TEXT=$("$CLIP_TOOL" paste 2>/dev/null || true)
else
    TEXT=$("$CLIP_TOOL" primary-paste 2>/dev/null || true)
fi

if [ -z "$TEXT" ]; then
    exit 1
fi

# Strip markdown formatting before TTS
CLEAN_TEXT=$(echo "$TEXT" | perl -0777 -pe '
  # Remove code blocks (triple backticks)
  s/```.*?```//gs;
  # Remove inline code
  s/`([^`]+)`/$1/g;
  # Strip bold **text** → text
  s/\*\*([^*]+)\*\*/$1/g;
  # Strip bold __text__ → text
  s/__([^_]+)__/$1/g;
  # Strip italic *text* → text (but not asterisks around spaces)
  s/(?<!\*)\*(\S[^*]*\S)\*(?!\*)/$1/g;
  # Strip italic _text_ → text (word-boundary aware)
  s/(?<=\s|^)_(\S[^_]*\S)_(?=\s|$)/$1/g;
  # Strip strikethrough ~~text~~ → text
  s/~~([^~]+)~~/$1/g;
  # Strip images ![alt](url) → alt
  s/!\[([^\]]*)\]\([^)]*\)/$1/g;
  # Strip links [text](url) → text
  s/\[([^\]]*)\]\([^)]*\)/$1/g;
  # Strip header markers (# Header → Header)
  s/^#{1,6}\s+//gm;
  # Strip horizontal rules (---, ***, ___)
  s/^[-*_]{3,}\s*$//gm;
  # Strip blockquote markers (> text → text)
  s/^>\s+//gm;
  # Strip unordered list markers (-, *, +)
  s/^[\t ]*[-*+]\s+//gm;
  # Strip ordered list markers (1. 2. etc.)
  s/^[\t ]*\d+\.\s+//gm;
')

if [ -z "$CLEAN_TEXT" ]; then
    # If stripping emptied it, use original
    CLEAN_TEXT="$TEXT"
fi

echo "$CLEAN_TEXT" > "$QUEUE_FILE"

exit 0
